<Project>

  <PropertyGroup>
    <!-- TreatWarningsAsErrors stays per project: the two libraries set true and
         the test projects set false, so hoisting a default would change behaviour. -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 only runs in the build when GenerateDocumentationFile is set; the projects without
         one report this advisory instead, and the format gate covers IDE0005 for them. -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

</Project>
