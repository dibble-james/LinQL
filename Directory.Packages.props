<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The .NET 10 SDK audits transitive packages (NuGetAuditMode=all), and
         pinning is how a flagged transitive gets lifted without inventing a
         direct reference to it. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="FastExpressionCompiler" Version="4.1.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="GraphQL.Client" Version="6.0.2" />
    <PackageVersion Include="GraphQL.Client.Serializer.SystemTextJson" Version="6.0.2" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="13.9.20" />
    <PackageVersion Include="HotChocolate.Language" Version="13.9.20" />
    <PackageVersion Include="HotChocolate.Language.SyntaxTree" Version="13.9.20" />
    <PackageVersion Include="HotChocolate.Language.Utf8" Version="13.9.20" />
    <PackageVersion Include="HotChocolate.Language.Visitors" Version="13.9.20" />
    <PackageVersion Include="IsExternalInit" Version="1.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <!-- Only reaches analyzers/dotnet/cs: the generator loads HotChocolate's
         parser, which depends on this. HotChocolate.AspNetCore already drags in
         8.0.0 for the test project, so 8.0.0 is the version to pin. -->
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="8.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageVersion Include="NodaTime" Version="3.3.7" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Snapshooter.Xunit" Version="0.14.1" />
    <PackageVersion Include="StrawberryShake.Core" Version="16.7.3" />
    <PackageVersion Include="System.Linq.Async" Version="6.0.1" />
    <!-- Also packed into analyzers/dotnet/cs for the generator, so the version
         here decides the DLL that ships. 8.0.0 is flagged by NU1903. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />
    <PackageVersion Include="xunit" Version="2.7.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

</Project>
