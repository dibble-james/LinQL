#nullable enable
#pragma warning disable CS8618
namespace Filtering
{
    using System.Text.Json;
    using LinQL;
    using LinQL.Description;
    using LinQL.Translation;
    using Microsoft.Extensions.Logging;
    using Microsoft.Extensions.DependencyInjection;

    [GraphQLType(Name = "Query")]
    [OperationType(RootOperationType.Query)]
    public partial class Query : RootType<Query>
    {
        public Product[] Products { get; set; } = null !;

        [GraphQLOperation, GraphQLField(Name = "products")]
        public Product[] ExecuteProducts([GraphQLArgument(GQLType = "ProductFilterInput")] ProductFilterInput? where, [GraphQLArgument(GQLType = "Int")] int? @in) => Products;
        [GraphQLFilter(Field = "products", Argument = "where", GQLType = "ProductFilterInput")]
        public Product[] FilterProducts(System.Linq.Expressions.Expression<System.Func<ProductFilterInputBuilder, ProductFilterInputBuilder>> _) => Products;
    }

    [GraphQLType(Name = "Product")]
    public partial class Product
    {
        public string Name { get; set; }
        public float Price { get; set; }
        public Tag[] Tags { get; set; }
    }

    [GraphQLType(Name = "Tag")]
    public partial class Tag
    {
        public string Label { get; set; }
    }

    [GraphQLType(Name = "ProductFilterInput")]
    public partial class ProductFilterInput
    {
        public ProductFilterInput[]? And { get; set; }
        public ProductFilterInput[]? Or { get; set; }
        public StringOperationFilterInput? Name { get; set; }
        public NumberOperationFilterInput? Price { get; set; }
        public ListFilterInputTypeOfTagFilterInput? Tags { get; set; }
    }

    public partial class ProductFilterInputBuilder
    {
        [GraphQLFilterField(Name = "and", IsList = true)]
        public ProductFilterInputBuilder And(System.Func<ProductFilterInputBuilder, ProductFilterInputBuilder> and) => this;
        [GraphQLFilterField(Name = "or", IsList = true)]
        public ProductFilterInputBuilder Or(System.Func<ProductFilterInputBuilder, ProductFilterInputBuilder> or) => this;
        [GraphQLFilterField(Name = "name")]
        public ProductFilterInputBuilder Name(System.Func<StringOperationFilterInputBuilder, StringOperationFilterInputBuilder> name) => this;
        [GraphQLFilterField(Name = "price")]
        public ProductFilterInputBuilder Price(System.Func<NumberOperationFilterInputBuilder, NumberOperationFilterInputBuilder> price) => this;
        [GraphQLFilterField(Name = "tags")]
        public ProductFilterInputBuilder Tags(System.Func<ListFilterInputTypeOfTagFilterInputBuilder, ListFilterInputTypeOfTagFilterInputBuilder> tags) => this;
    }

    [GraphQLType(Name = "StringOperationFilterInput")]
    public partial class StringOperationFilterInput
    {
        public string? Eq { get; set; }
        public string? Contains { get; set; }
    }

    public partial class StringOperationFilterInputBuilder
    {
        [GraphQLFilterField(Name = "eq")]
        public StringOperationFilterInputBuilder Eq(string? eq) => this;
        [GraphQLFilterField(Name = "contains")]
        public StringOperationFilterInputBuilder Contains(string? contains) => this;
    }

    [GraphQLType(Name = "NumberOperationFilterInput")]
    public partial class NumberOperationFilterInput
    {
        public float? Eq { get; set; }
        public float? Gt { get; set; }
        public float? Lt { get; set; }
    }

    public partial class NumberOperationFilterInputBuilder
    {
        [GraphQLFilterField(Name = "eq")]
        public NumberOperationFilterInputBuilder Eq(float? eq) => this;
        [GraphQLFilterField(Name = "gt")]
        public NumberOperationFilterInputBuilder Gt(float? gt) => this;
        [GraphQLFilterField(Name = "lt")]
        public NumberOperationFilterInputBuilder Lt(float? lt) => this;
    }

    [GraphQLType(Name = "TagFilterInput")]
    public partial class TagFilterInput
    {
        public StringOperationFilterInput? Label { get; set; }
    }

    public partial class TagFilterInputBuilder
    {
        [GraphQLFilterField(Name = "label")]
        public TagFilterInputBuilder Label(System.Func<StringOperationFilterInputBuilder, StringOperationFilterInputBuilder> label) => this;
    }

    [GraphQLType(Name = "ListFilterInputTypeOfTagFilterInput")]
    public partial class ListFilterInputTypeOfTagFilterInput
    {
        public TagFilterInput? Some { get; set; }
        public TagFilterInput? All { get; set; }
        public TagFilterInput? None { get; set; }
        public bool? Any { get; set; }
    }

    public partial class ListFilterInputTypeOfTagFilterInputBuilder
    {
        [GraphQLFilterField(Name = "some")]
        public ListFilterInputTypeOfTagFilterInputBuilder Some(System.Func<TagFilterInputBuilder, TagFilterInputBuilder> some) => this;
        [GraphQLFilterField(Name = "all")]
        public ListFilterInputTypeOfTagFilterInputBuilder All(System.Func<TagFilterInputBuilder, TagFilterInputBuilder> all) => this;
        [GraphQLFilterField(Name = "none")]
        public ListFilterInputTypeOfTagFilterInputBuilder None(System.Func<TagFilterInputBuilder, TagFilterInputBuilder> none) => this;
        [GraphQLFilterField(Name = "any")]
        public ListFilterInputTypeOfTagFilterInputBuilder Any(bool? any) => this;
    }

    public static class LinQLOptionExtensions
    {
        public static LinQLOptions WithKnownScalars(this LinQLOptions options)
        {
            options.Scalars.Add(new("Int", "int"));
            options.Scalars.Add(new("Float", "float"));
            options.Scalars.Add(new("String", "string"));
            options.Scalars.Add(new("Id", "string"));
            options.Scalars.Add(new("Boolean", "bool"));
            return options;
        }
    }

    public static class JsonSerializerOptionsExtensions
    {
        public static JsonSerializerOptions WithKnownInterfaces(this JsonSerializerOptions options)
        {
            return options;
        }
    }
}
