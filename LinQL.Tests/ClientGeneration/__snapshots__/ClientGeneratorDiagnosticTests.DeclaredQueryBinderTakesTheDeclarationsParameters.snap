namespace Queries
{
    public static class DeclarationsValue
    {
        public const string Document = "query linql($var1: ID!) {\n  __typename\n  character(id: $var1) {\n    __typename\n    name\n  }\n}";
        public static global::LinQL.LinQLDeclaredQueryRequest Value(string id, int? count) => global::LinQL.LinQLDeclaredQueryRequest.Bind(Document, ("var1", id));
    }
}
